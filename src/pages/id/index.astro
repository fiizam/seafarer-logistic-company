---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Hero from '../../components/id/Hero.astro';
import TrackingWidget from '../../components/TrackingWidget';
import QuoteCalculator from '../../components/QuoteCalculator';
import Sustainability from '../../components/id/Sustainability.astro';
import AboutUs from '../../components/id/AboutUs.astro';
import Services from '../../components/id/Services.astro';
import Stats from '../../components/id/Stats.astro';
import Process from '../../components/id/Process.astro';
import Fleet from '../../components/id/Fleet.astro';
import GlobalNetwork from '../../components/id/GlobalNetwork.astro';
import WhyChooseUs from '../../components/id/WhyChooseUs.astro';
import Testimonials from '../../components/id/Testimonials.astro';
import News from '../../components/id/News.astro';
import FAQ from '../../components/id/FAQ.astro';
import Contact from '../../components/id/Contact.astro';
import Footer from '../../components/id/Footer.astro';
---

<Layout title="Seafarer Logistics | Solusi Pengiriman Global">
  <Navbar client:load />
  <main>
    <Hero />
    
    <section class="relative z-20 -mt-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto mb-24">
      <TrackingWidget client:load />
    </section>

    <AboutUs />
    <Services />
    <Stats />
    <Process />
    <Fleet />
    <GlobalNetwork />
    <WhyChooseUs />
    <Sustainability />
    <Testimonials />
    <News />
    
    <section id="quote" class="py-24 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <QuoteCalculator client:load />
      </div>
    </section>

    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
