---
import pkg from 'lucide-react';
const { Navigation, Anchor, Maximize } = pkg;

const vessels = [
  {
    type: "Kapal Kontainer",
    name: "Seafarer Alpha",
    capacity: "24,000 TEU",
    length: "400m",
    image: "/images/fleet-1.png"
  },
  {
    type: "Kapal Curah",
    name: "Oceanic Pioneer",
    capacity: "180,000 DWT",
    length: "290m",
    image: "/images/fleet-2.png"
  }
];
---

<section id="fleet" class="py-24 bg-navy-900 text-white relative overflow-hidden">
  {/* Abstract Background */}
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-96 h-96 bg-electric rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-[30rem] h-[30rem] bg-blue-400 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 fleet-header">
      <div class="max-w-2xl">
        <h4 class="text-electric font-semibold tracking-wider uppercase text-sm mb-3">Armada & Peralatan</h4>
        <h2 class="text-4xl lg:text-5xl font-bold mb-6">
          Kapal maritim mutakhir
        </h2>
        <p class="text-slate-300 text-lg">
          Armada modern kami dilengkapi teknologi canggih untuk memastikan efisiensi optimal, emisi rendah, dan transportasi aman untuk beragam jenis kargo.
        </p>
      </div>
      <div>
        <a href="#" class="inline-flex items-center gap-2 border border-white/20 hover:bg-white/10 px-6 py-3 rounded-full transition-colors">
          Lihat Spesifikasi Lengkap
        </a>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {vessels.map((vessel, i) => (
        <div class="fleet-card group bg-navy-800/50 rounded-2xl overflow-hidden border border-white/10 hover:border-electric/50 transition-colors backdrop-blur-sm">
          <div class="h-64 overflow-hidden relative">
            <div class="absolute inset-0 bg-navy-900/20 group-hover:bg-transparent transition-colors z-10"></div>
            <img 
              src={vessel.image} 
              alt={vessel.name} 
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-4 left-4 z-20 bg-black/50 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider border border-white/10">
              {vessel.type}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-4 group-hover:text-electric transition-colors">{vessel.name}</h3>
            
            <div class="space-y-3">
              <div class="flex items-center justify-between py-2 border-b border-white/10">
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                  <Maximize class="w-4 h-4" /> Kapasitas
                </div>
                <span class="font-medium text-white">{vessel.capacity}</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-white/10">
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                  <Navigation class="w-4 h-4" /> Panjang
                </div>
                <span class="font-medium text-white">{vessel.length}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  // Use astro:page-load for ViewTransitions compatibility
  document.addEventListener('astro:page-load', () => {
    gsap.registerPlugin(ScrollTrigger);
    
    gsap.fromTo('.fleet-header', 
      { y: 30, opacity: 0 },
      { 
        y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
        scrollTrigger: {
          trigger: '#fleet',
          start: 'top 80%',
        }
      }
    );

    gsap.fromTo('.fleet-card',
      { y: 50, opacity: 0 },
      { 
        y: 0, opacity: 1, duration: 0.8, stagger: 0.2, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.fleet-card',
          start: 'top 80%',
        }
      }
    );
  });
</script>
