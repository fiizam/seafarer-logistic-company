---
import pkg from 'lucide-react';
const { MapPin, Globe2 } = pkg;
---

<section id="network" class="py-24 bg-slate-50 relative overflow-hidden">
  {/* Decorative Globe Background */}
  <div class="absolute -right-64 top-1/2 -translate-y-1/2 text-slate-200/50 -z-0">
    <Globe2 class="w-96 h-96 lg:w-[800px] lg:h-[800px]" strokeWidth={0.5} />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <div class="network-content">
        <h4 class="text-electric font-semibold tracking-wider uppercase text-sm mb-3">Jangkauan Global</h4>
        <h2 class="text-4xl lg:text-5xl font-bold text-navy-900 mb-6">
          Menghubungkan benua, memberdayakan perdagangan.
        </h2>
        <p class="text-slate-600 mb-8 text-lg text-balance">
          Jaringan internasional kami yang luas mencakup pelabuhan utama dan pusat pedalaman di lebih dari 150 negara. Dengan aliansi strategis dan kantor regional kami sendiri, kami memastikan konektivitas global tanpa batas dan keahlian lokal ke mana pun kargo Anda harus dikirim.
        </p>

        <div class="grid grid-cols-2 gap-8 mb-10">
          <div>
            <div class="text-4xl font-bold text-navy-900 mb-2">150+</div>
            <div class="text-slate-500 font-medium text-sm uppercase tracking-wide">Negara Terjangkau</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-navy-900 mb-2">400+</div>
            <div class="text-slate-500 font-medium text-sm uppercase tracking-wide">Pusat Logistik</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-navy-900 mb-2">10k+</div>
            <div class="text-slate-500 font-medium text-sm uppercase tracking-wide">Karyawan Global</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-navy-900 mb-2">99%</div>
            <div class="text-slate-500 font-medium text-sm uppercase tracking-wide">Tepat Waktu</div>
          </div>
        </div>

        <a href="#" class="inline-flex items-center gap-2 text-electric font-semibold hover:text-navy-900 transition-colors">
          Lihat Kantor Global Kami <span class="text-xl leading-none">→</span>
        </a>
      </div>

      <div class="relative h-72 md:h-96 lg:h-[500px] bg-navy-900 rounded-[3rem] shadow-soft border-4 border-white p-4 network-map overflow-hidden flex items-center justify-center">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=1000&auto=format&fit=crop')] bg-cover bg-no-repeat bg-center opacity-30 hover:scale-105 transition-transform duration-700"></div>
        {/* Animated Location Pins */}
        {[
          { top: '30%', left: '20%', label: 'New York' },
          { top: '45%', left: '48%', label: 'London' },
          { top: '55%', left: '55%', label: 'Dubai' },
          { top: '60%', left: '75%', label: 'Singapore' },
          { top: '40%', left: '85%', label: 'Tokyo' }
        ].map(pin => (
          <div class="absolute map-pin" style={{ top: pin.top, left: pin.left }}>
            <div class="relative group">
              <span class="absolute inline-flex h-4 w-4 rounded-full bg-electric opacity-75 animate-ping -top-1 -left-1"></span>
              <MapPin class="w-6 h-6 text-white relative z-10 transform -translate-x-1/2 -translate-y-1/2" fill="#007BFF" />
              <div class="absolute top-4 left-1/2 -translate-x-1/2 bg-white text-navy-900 text-xs py-1 px-2 rounded font-bold opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                {pin.label}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  document.addEventListener('astro:page-load', () => {
    gsap.registerPlugin(ScrollTrigger);
    
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#network',
        start: 'top 75%',
      }
    });

    tl.fromTo('.network-content', 
      { x: -50, opacity: 0 },
      { x: 0, opacity: 1, duration: 1, ease: 'power3.out' }
    )
    .fromTo('.network-map',
      { x: 50, opacity: 0 },
      { x: 0, opacity: 1, duration: 1, ease: 'power3.out' },
      "-=0.8"
    )
    .fromTo('.map-pin',
      { scale: 0, opacity: 0 },
      { scale: 1, opacity: 1, duration: 0.5, stagger: 0.1, ease: 'back.out(1.5)' },
      "-=0.4"
    );
  });
</script>
