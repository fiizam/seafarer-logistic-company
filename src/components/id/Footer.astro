---
import pkg from 'lucide-react';
const { Anchor, MapPin, Mail, Phone } = pkg;
---

<footer class="bg-navy-900 text-slate-300 pt-20 pb-10 border-t border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      {/* Brand & Intro */}
      <div class="space-y-6">
        <div class="flex items-center gap-2 text-white">
          <Anchor class="w-8 h-8 text-electric" />
          <span class="font-extrabold text-2xl tracking-tight">SEAFARER</span>
        </div>
        <p class="text-slate-400 leading-relaxed text-sm">
          Global logistics and maritime shipping solutions built for the modern supply chain. Fast, secure, and sustainable.
        </p>
        <div class="flex items-center gap-4 pt-2">
          <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-slate-300 hover:bg-electric hover:text-white transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" /></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-slate-300 hover:bg-electric hover:text-white transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" /></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-slate-300 hover:bg-electric hover:text-white transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" /></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-slate-300 hover:bg-electric hover:text-white transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>

      {/* Tautan Cepat */}
      <div>
        <h4 class="text-white font-semibold mb-6">Company</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#about" class="hover:text-electric transition-colors">Tentang Kami</a></li>
          <li><a href="#services" class="hover:text-electric transition-colors">Our Layanan</a></li>
          <li><a href="#network" class="hover:text-electric transition-colors">Global Network</a></li>
          <li><a href="#" class="hover:text-electric transition-colors">Careers</a></li>
          <li><a href="#" class="hover:text-electric transition-colors">News & Media</a></li>
        </ul>
      </div>

      {/* Layanan */}
      <div>
        <h4 class="text-white font-semibold mb-6">Layanan</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#" class="hover:text-electric transition-colors">Ocean Freight</a></li>
          <li><a href="#" class="hover:text-electric transition-colors">Air Freight</a></li>
          <li><a href="#" class="hover:text-electric transition-colors">Project Cargo</a></li>
          <li><a href="#" class="hover:text-electric transition-colors">Customs Brokerage</a></li>
          <li><a href="#" class="hover:text-electric transition-colors">Supply Chain Solutions</a></li>
        </ul>
      </div>

      {/* Contact Info */}
      <div>
        <h4 class="text-white font-semibold mb-6">Contact Us</h4>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-electric flex-shrink-0" />
            <span>123 Logistics Blvd, Suite 400<br/>Port City, PC 90210, USA</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone class="w-5 h-5 text-electric flex-shrink-0" />
            <span>+1 (800) 555-0199</span>
          </li>
          <li class="flex items-center gap-3">
            <Mail class="w-5 h-5 text-electric flex-shrink-0" />
            <a href="mailto:info@seafarer.com" class="hover:text-white transition-colors">info@seafarer.com</a>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} Seafarer Logistics. Hak cipta dilindungi undang-undang.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">Kebijakan Privasi</a>
        <a href="#" class="hover:text-white transition-colors">Syarat Layanan</a>
        <a href="#" class="hover:text-white transition-colors">Kebijakan Cookie</a>
      </div>
    </div>
  </div>
</footer>
