---
import pkg from 'lucide-react';
const { ClipboardList, Box, PlaneTakeoff, Home } = pkg;

const steps = [
  {
    icon: ClipboardList,
    title: "1. Request & Planning",
    description: "Submit your requirements and our experts will design an optimized logistics plan tailored to your cargo."
  },
  {
    icon: Box,
    title: "2. Packaging & Pickup",
    description: "We handle secure packaging and pick up your cargo directly from your facility or warehouse."
  },
  {
    icon: PlaneTakeoff,
    title: "3. Transit & Tracking",
    description: "Your cargo is dispatched via optimal routes while you monitor progress with real-time tracking."
  },
  {
    icon: Home,
    title: "4. Safe Delivery",
    description: "Cargo is cleared through customs and delivered safely to its final destination on schedule."
  }
];
---

<section id="process" class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20 process-header">
      <h4 class="text-electric font-semibold tracking-wider uppercase text-sm mb-3">How It Works</h4>
      <h2 class="text-4xl lg:text-5xl font-bold text-navy-900 mb-6">
        A seamless shipping experience
      </h2>
      <p class="text-slate-600 text-lg">
        Our streamlined 4-step process ensures maximum efficiency and transparency from the moment you request a quote to final delivery.
      </p>
    </div>

    <div class="relative">
      {/* Connecting Wavy Path (Illustrative) */}
      <div class="hidden lg:block absolute top-12 left-[10%] right-[10%] h-12 z-0 opacity-30">
        <svg width="100%" height="100%" viewBox="0 0 100 10" preserveAspectRatio="none">
          <path d="M0,5 Q25,10 50,5 T100,5" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2, 2" class="text-navy-900" />
        </svg>
      </div>

      <div class="grid lg:grid-cols-4 gap-12 relative z-10">
        {steps.map((step, index) => {
          const Icon = step.icon;
          return (
            <div class="process-step text-center group">
              <div class="w-24 h-24 mx-auto bg-white rounded-[2rem] border-[3px] border-accent-light shadow-soft flex items-center justify-center mb-6 relative transition-transform duration-500 group-hover:-translate-y-4 group-hover:border-electric/30 group-hover:rotate-6">
                <div class="absolute inset-0 rounded-[2rem] bg-electric/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <Icon class="w-10 h-10 text-electric relative z-10" />
                
                {/* Step number badge */}
                <div class="absolute -bottom-3 -right-3 w-10 h-10 bg-navy-900 text-white rounded-xl flex items-center justify-center text-sm font-extrabold border-4 border-white shadow-sm transform -rotate-6">
                  {index + 1}
                </div>
              </div>
              <h3 class="text-xl font-bold text-navy-900 mb-3">{step.title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm">
                {step.description}
              </p>
            </div>
          )
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  document.addEventListener('astro:page-load', () => {
    gsap.registerPlugin(ScrollTrigger);
    
    gsap.fromTo('.process-header', 
      { y: 30, opacity: 0 },
      { 
        y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
        scrollTrigger: {
          trigger: '#process',
          start: 'top 80%',
        }
      }
    );

    const stepTl = gsap.timeline({
      scrollTrigger: {
        trigger: '.process-step',
        start: 'top 75%',
      }
    });

    stepTl.fromTo('.process-step',
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, stagger: 0.2, ease: 'back.out(1.2)' }
    )
    .to('.process-line', { width: '100%', duration: 1.5, ease: 'power2.inOut' }, "-=0.8");
  });
</script>
