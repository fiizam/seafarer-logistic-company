---
import pkg from 'lucide-react';
const { ArrowRight, Ship, ShieldCheck, Clock, MapPin } = pkg;
---

<section id="home" class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  {/* Realistic Background Image */}
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-navy-900/70 z-10"></div>
    <img 
      src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?q=80&w=2070&auto=format&fit=crop" 
      alt="Logistics Cargo Ship" 
      class="w-full h-full object-cover"
    />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full pt-12 pb-32">
    <div class="max-w-3xl">
      <div class="hero-content">
        
        <h1 class="text-4xl md:text-6xl lg:text-[4.5rem] font-extrabold text-white leading-tight mb-6 hero-stagger">
          Global Logistics, <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-electric to-accent">
            Engineered for Precision.
          </span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-200 mb-10 max-w-xl hero-stagger text-balance font-medium">
          Delivering seamless end-to-end supply chain solutions with unmatched reliability, real-time visibility, and state-of-the-art infrastructure designed for the future of global trade.
        </p>
        
        <div class="flex flex-wrap items-center gap-4 hero-stagger">
          <a href="#services" class="bg-electric hover:bg-electric-hover text-white px-8 py-4 rounded-xl font-bold transition-all flex items-center gap-2 group shadow-lg">
            Explore Services
            <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="#quote" class="px-8 py-4 rounded-xl font-bold text-white border-2 border-white/20 hover:bg-white/10 transition-all shadow-sm">
            Get a Quote
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  
  const initHeroAnimations = () => {
    const tl = gsap.timeline();
    
    tl.fromTo('.hero-stagger', 
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: 'power3.out', delay: 0.2 }
    );
  };

  document.addEventListener('astro:page-load', initHeroAnimations);
</script>
